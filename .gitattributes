# 统一换行：文本入库为 LF，Windows 批处理保留 CRLF
* text=auto

*.md text eol=lf
*.py text eol=lf
*.json text eol=lf
*.svg text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制：不做换行转换
*.exe binary
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary
*.7z binary
